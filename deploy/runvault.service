[Unit]
Description=RunVault Raspberry Pi replay server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wxp
WorkingDirectory=/home/wxp/runvault
Environment=RUNVAULT_DATA_DIR=/home/wxp/runvault/data
Environment=RUNVAULT_UPLOAD_TOKEN=DEMO_UPLOAD_TOKEN
Environment=RUNVAULT_ADMIN_TOKEN=DEMO_ADMIN_TOKEN
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ExecStart=/home/wxp/runvault/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 80
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
